{
  "name": "cnvtr",
  "version": "1.0.2",
  "description": "Convert public media URLs to high-quality audio (MP3, WAV) for creators, DJs, and producers",
  "main": "main.js",
  "author": "CNVTR",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "bundle:deps": "node scripts/bundle-ytdlp.js",
    "build": "npm run bundle:deps && vite build && electron-builder",
    "build:win": "npm run bundle:deps && vite build && electron-builder --win --config.win.signAndEditExecutable=false",
    "build:mac": "npm run bundle:deps && vite build && electron-builder --mac",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run bundle:deps && vite build && electron-builder --config.win.signAndEditExecutable=false",
    "import:dj-set": "electron . --import=./dj_set_import_urls.txt --accept-terms",
    "cleanup:dj-set-dupes": "node scripts/cleanup-dj-set-dupes.js",
    "build:dj-set-yt-cache": "node scripts/build-dj-set-yt-cache.js",
    "order:dj-set": "node scripts/order-dj-set-by-playlist.js",
    "test": "node --test ./test/safePaths.test.js ./test/platforms.test.js ./test/queueLogic.test.js",
    "lint": "eslint main.js preload.js backend scripts test",
    "bundle:ci:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ci-bundle-binaries.ps1",
    "bundle:ci:mac": "bash scripts/ci-bundle-binaries.sh"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "music-metadata": "^11.2.0",
    "node-id3": "^0.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "extends": "./electron-builder.config.js"
  }
}
